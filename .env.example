# Application Port
PORT=8080

# MongoDB URI (use local mongo or CosmosDB MongoDB URI)
MONGO_URI=mongodb://localhost:27017/resume-analyzer

# JWT secret key for signing tokens
JWT_SECRET=supersecretjwtkeyforresumeanalyzer123!

# Azure Storage details (Optional: falling back to local storage if empty)
# Connection String (Option A)
AZURE_STORAGE_CONNECTION_STRING=
# Managed Identity (Option B - App Service)
AZURE_STORAGE_ACCOUNT_NAME=
# Container Name
AZURE_STORAGE_CONTAINER_NAME=resumes
